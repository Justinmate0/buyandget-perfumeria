# Postgres de Supabase, solo como base de datos (Session pooler, puerto 5432).
# Sustituye el usuario, la contraseña y el host por los de tu proyecto.
# No uses la conexión directa ni actives RLS: Medusa se conecta con este usuario.
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:tu_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=no-verify

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:8000

JWT_SECRET=cambia-este-secreto-jwt
COOKIE_SECRET=cambia-este-secreto-cookie
